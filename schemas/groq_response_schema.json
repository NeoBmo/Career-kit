{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["summary", "experience_order", "skills_order", "notes"],
  "properties": {
    "summary": { "type": "string" },
    "experience_order": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "skills_order": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer", "minimum": 0 }
    },
    "notes": { "type": "string" }
  }
}
